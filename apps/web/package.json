{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "description": "NP Commerce OS — Next.js + PWA + Capacitor (iOS/Android)",
  "scripts": {
    "dev": "bash -c 'ulimit -n 8192 2>/dev/null; next dev -H ${WEB_HOST:-0.0.0.0} -p ${WEB_PORT:-3000}'",
    "preview": "bash -c 'ulimit -n 8192 2>/dev/null; next build && next start -H ${WEB_HOST:-0.0.0.0} -p ${WEB_PORT:-3000}'",
    "start:lan": "bash -c 'ulimit -n 8192 2>/dev/null; next start -H 0.0.0.0 -p ${WEB_PORT:-3000}'",
    "build": "next build",
    "build:static": "BUILD_STATIC=true next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "assets:render": "node scripts/build-mobile-assets.mjs",
    "assets:generate": "capacitor-assets generate --pwaManifestPath public/manifest.json --iconBackgroundColor '#FF3E5C' --iconBackgroundColorDark '#FF3E5C' --splashBackgroundColor '#FF3E5C' --splashBackgroundColorDark '#FF3E5C'",
    "assets:build": "pnpm assets:render && pnpm assets:generate && bash -c '[ -d icons ] && mv icons/*.webp public/icons/ && rmdir icons || true'",
    "mobile:build": "BUILD_STATIC=true next build && cap sync",
    "cap:init": "cap init 'NP Commerce' 'app.np.commerce' --web-dir=out",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cap sync ios",
    "cap:sync:android": "cap sync android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:dev:ios": "cap run ios -l --external",
    "cap:dev:android": "cap run android -l --external",
    "cap:doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capgo/capacitor-updater": "6",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@np/types": "workspace:*",
    "@sentry/capacitor": "4.0.0",
    "@sentry/nextjs": "10.43.0",
    "@tanstack/react-query": "^5.51.0",
    "clsx": "^2.1.1",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.0",
    "@np/config": "workspace:*",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.39",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.0"
  }
}
