# Phase 19.2 — Web build-time env (release APK + production web)
#
# Capacitor native shell อ่านค่าเหล่านี้ตอน `pnpm build` (Next.js inlines
# NEXT_PUBLIC_* vars เข้าไปใน static bundle). Bundle ใน APK / AAB จะใช้ค่านี้
# จนกว่าจะ build ใหม่และ ship native shell version ใหม่.
#
# ⚠️ ถ้า Railway URL เปลี่ยน (เช่นย้ายไป custom domain api.np.app) ต้อง:
#   1. เปลี่ยนค่าตรงนี้
#   2. Rebuild + cap sync + assembleRelease + push ผ่าน OTA หรือ store update

NEXT_PUBLIC_API_URL=https://api.tuk-tuk.mobi
NEXT_PUBLIC_SENTRY_DSN=https://ecdbe28aaff0d78584003be31934af4e@o4511442670190592.ingest.us.sentry.io/4511442743459840
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_LIVE_UPDATES_DEFAULT_CHANNEL=beta

# Phase 21 — LIFF (LINE Login). Public; baked into static bundle.
NEXT_PUBLIC_LINE_LIFF_ID=2010217504-PXW0Rrsi

# Phase 21.2 — Google OAuth Web Client ID. Public; baked into static bundle.
# Required by both Google Identity Services SDK (web) and the Capacitor
# plugin's `serverClientId` (native Android picker). Note: only the WEB
# client ID appears in code — the Android client ID is registered against
# our APK's SHA-1 fingerprint in Google Cloud Console but is never
# referenced directly. The Android plugin still returns an id_token whose
# `aud` claim equals THIS web client id, so backend verification is
# uniform across platforms.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=334919791355-rn81prdufp1c0fee0ct0usrn38p7b9r7.apps.googleusercontent.com
