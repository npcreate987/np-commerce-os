# Phase 18 — Fastlane Fastfile (iOS).
#
# Lanes:
#   ios beta    — TestFlight (Closed Beta + Phased rollout via App Store)
#   ios release — App Store production (manual review trigger)
#
# Both lanes:
#   1) Authenticate (App Store Connect API key)
#   2) `match` syncs signing assets from private git repo
#   3) Bump build number to GITHUB_RUN_NUMBER (or a manual fallback)
#   4) `gym` builds + archives + exports .ipa
#   5) Upload dSYM zip to Sentry (release tag = ENV["SENTRY_RELEASE"])
#   6) `pilot` (TestFlight) or `deliver` (App Store) upload
#
# Invoke from CI:
#   bundle exec fastlane beta
#
# All ENV reads default safely — running locally without secrets prompts.

default_platform(:ios)

WORKSPACE = "App/App.xcworkspace"
SCHEME    = "App"
EXPORT_METHOD = "app-store"

platform :ios do

  before_all do |lane, options|
    setup_ci if ENV["CI"]
    if ENV["APPLE_API_KEY_ID"] && ENV["APPLE_API_KEY_ISSUER_ID"] && ENV["APPLE_API_KEY_CONTENT"]
      app_store_connect_api_key(
        key_id: ENV["APPLE_API_KEY_ID"],
        issuer_id: ENV["APPLE_API_KEY_ISSUER_ID"],
        key_content: ENV["APPLE_API_KEY_CONTENT"],
        is_key_content_base64: true,
        in_house: false,
      )
    end
  end

  desc "Sync signing assets from the match git repo (readonly)"
  private_lane :sync_certs do
    match(
      type: "appstore",
      readonly: true,
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier: [ENV["APPLE_BUNDLE_ID"] || "app.np.commerce"],
    )
  end

  desc "Stamp build + version numbers"
  private_lane :stamp_build do |options|
    build_number = (ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")).to_s
    version_number = ENV["VERSION_NUMBER"] || "1.0.0"
    increment_build_number(
      build_number: build_number,
      xcodeproj: "App/App.xcodeproj",
    )
    increment_version_number(
      version_number: version_number,
      xcodeproj: "App/App.xcodeproj",
    )
    UI.message("📦 Built #{version_number} (#{build_number})")
  end

  desc "Build .ipa + dSYM"
  private_lane :build_ipa do
    cocoapods(
      podfile: "App/Podfile",
      try_repo_update_on_error: true,
    )
    gym(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: EXPORT_METHOD,
      output_directory: "build",
      output_name: "NPCommerce.ipa",
      include_bitcode: false,
      include_symbols: true,
      clean: true,
    )
  end

  desc "Upload dSYM to Sentry for symbolication"
  private_lane :upload_dsym do
    next unless ENV["SENTRY_AUTH_TOKEN"]
    sentry_debug_files_upload(
      auth_token: ENV["SENTRY_AUTH_TOKEN"],
      org_slug: ENV["SENTRY_ORG"],
      project_slug: ENV["SENTRY_PROJECT"],
      path: "build/",
    )
    if ENV["SENTRY_RELEASE"]
      sentry_create_release(
        auth_token: ENV["SENTRY_AUTH_TOKEN"],
        org_slug: ENV["SENTRY_ORG"],
        project_slug: ENV["SENTRY_PROJECT"],
        version: ENV["SENTRY_RELEASE"],
        finalize: true,
      )
    end
  end

  desc "🚀 TestFlight beta"
  lane :beta do
    sync_certs
    stamp_build
    build_ipa
    upload_dsym
    pilot(
      ipa: "build/NPCommerce.ipa",
      skip_waiting_for_build_processing: false,
      changelog: ENV["CHANGELOG"] || "Internal beta build ##{ENV['BUILD_NUMBER']}",
      distribute_external: false,
    )
  end

  desc "🏪 Submit to App Store review"
  lane :release do
    sync_certs
    stamp_build
    build_ipa
    upload_dsym
    deliver(
      ipa: "build/NPCommerce.ipa",
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
    )
  end

  error do |lane, exception|
    UI.error("❌ Lane #{lane} failed: #{exception.message}")
  end
end
