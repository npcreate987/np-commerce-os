<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>TuKTuK</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- ============================================================== -->
	<!-- Phase 16 — Required purpose strings + capabilities -->
	<!-- ============================================================== -->

	<!-- Camera (composer + future KYC) -->
	<key>NSCameraUsageDescription</key>
	<string>TuKTuK ใช้กล้องเพื่อถ่ายคลิปลงฟีดและรูปสินค้า</string>

	<!-- Photo Library (composer pick + product images) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TuKTuK ขอเข้าถึงรูปและคลิปเพื่อใช้โพสต์ลงฟีด</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TuKTuK บันทึกรูปสินค้าที่คุณดาวน์โหลดลงคลังภาพ</string>

	<!-- Microphone (video recording with audio) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>TuKTuK ใช้ไมโครโฟนเพื่อบันทึกเสียงในคลิปวิดีโอที่คุณถ่าย</string>

	<!-- Location (Local Commerce / Rider) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TuKTuK ใช้ตำแหน่งของคุณเพื่อค้นหาร้านใกล้คุณและคำนวณค่าจัดส่ง</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Rider ใช้ตำแหน่งตลอดเวลาเพื่ออัปเดตการจัดส่งให้ลูกค้าและร้านค้า</string>

	<!-- Face ID / Touch ID (future biometric payment confirm) -->
	<key>NSFaceIDUsageDescription</key>
	<string>TuKTuK ใช้ Face ID เพื่อยืนยันการชำระเงินอย่างปลอดภัย</string>

	<!-- App Tracking Transparency (Phase 17 readiness) -->
	<key>NSUserTrackingUsageDescription</key>
	<string>TuKTuK ใช้ข้อมูลพฤติกรรมเพื่อแนะนำสินค้าและเนื้อหาที่คุณน่าจะชอบ คุณปิดได้ในหน้า "ความเป็นส่วนตัว"</string>

	<!-- Custom URL scheme (deep links เช่น OAuth redirect, partner share) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.np.commerce</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>npcommerce</string>
			</array>
		</dict>
	</array>

	<!-- App Transport Security: เฉพาะ dev (LAN IP) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Allow background audio for video feed (autoplay clips) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
