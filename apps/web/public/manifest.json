      "description": "ดูคลิปแนะนำสินค้า",
      "url": "/feed",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "ตะกร้า",
      "short_name": "ตะกร้า",
      "description": "ดูสินค้าที่เลือกไว้",
      "url": "/cart",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "คำสั่งซื้อของฉัน",
      "short_name": "ออเดอร์",
      "description": "ดูสถานะการสั่งซื้อ",
      "url": "/orders",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "ใกล้ฉัน",
      "short_name": "ใกล้ฉัน",
      "description": "ร้านอาหารและร้านท้องถิ่นใกล้ตัว",
      "url": "/local",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/feed/create",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "caption",
      "files": [
        {
          "name": "video",
          "accept": [
            "video/mp4",
            "video/webm",
            "video/quicktime"
          ]
        }
      ]
    }
  },
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=app.np.commerce",
      "id": "app.np.commerce"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/np-commerce/id000000000"
    }
  ]
