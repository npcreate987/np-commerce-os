{
  "extends": "@np/config/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@np/types": [
        "../../packages/types/src"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next-prod/types/**/*.ts",
    ".next-phase3/types/**/*.ts",
    ".next-phase5/types/**/*.ts",
    ".next-phase6/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
