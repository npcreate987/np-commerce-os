# ─── Common ────────────────────────────────────────────
NODE_ENV=development
APP_NAME=np-commerce-os

# ─── Web (Next.js) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── API (NestJS) ──────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/np_commerce

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Search ────────────────────────────────────────────
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=change-me

# ─── Storage (S3-compatible · Phase 9.2 + 12.1) ────────
# Leave keys blank for "mock" driver (returns synthetic URLs; review photo and
# video uploads are simulated). Set keys to enable real presigned PUT to
# S3 / R2 / MinIO / Wasabi.
#
# Per-purpose limits (enforced server-side · packages/types/src/storage.ts):
#   - review_photo, product_media, cs_attachment : 8 MB · JPEG/PNG/WebP/GIF
#   - shop_logo                                  : 4 MB · JPEG/PNG/WebP/GIF
#   - video        (Phase 12.1)                  : 100 MB · mp4/webm/quicktime
#   - video_thumb  (Phase 12.1)                  : 2 MB · JPEG/PNG (auto-poster)
#
# Driver auto-detected from S3_ENDPOINT:
#   - contains '.r2.cloudflarestorage.com' → R2 (path-style)
#   - contains 'minio'/':9000'/localhost   → MinIO (path-style)
#   - empty                                → AWS S3 (virtual-hosted)
#
# ⚠️ Cloudflare R2 setup checklist:
#   1. Create bucket: `wrangler r2 bucket create <name>` (or via dashboard)
#   2. Generate API token w/ "Object Read & Write" on the bucket
#   3. Set bucket CORS to allow browser PUT from your web origin, e.g.:
#        [{
#          "AllowedOrigins": ["http://localhost:3000","https://app.np-commerce.com"],
#          "AllowedMethods": ["GET","PUT","HEAD"],
#          "AllowedHeaders": ["*"],
#          "MaxAgeSeconds": 3600
#        }]
#   4. (Optional) Connect a custom domain for public reads; set S3_PUBLIC_BASE
#      to that CDN URL so the browser can stream videos w/o auth headers.
#
# Example — Cloudflare R2 production:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_BUCKET=np-commerce
#   S3_REGION=auto
#   S3_ACCESS_KEY=<r2-access-key-id>
#   S3_SECRET_KEY=<r2-secret-access-key>
#   S3_PUBLIC_BASE=https://cdn.np-commerce.com   # custom domain → bucket
S3_ENDPOINT=
S3_BUCKET=np-commerce
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Force path-style addressing (`https://host/bucket/key`) — true for MinIO/R2
S3_PATH_STYLE=
# Override public URL base (use when CDN/custom domain in front of bucket)
S3_PUBLIC_BASE=

# ─── Auth (Phase 13.3) ────────────────────────────────
JWT_SECRET=change-me-please
NEXTAUTH_SECRET=change-me-please
NEXTAUTH_URL=http://localhost:3000

# Access-token lifetime (any zeit/ms string: 15m, 1h, 7d). 1h default works
# with the refresh-token rotation introduced in Phase 13.3b.
JWT_ACCESS_TTL=1h

# Refresh-token lifetime (days) and rotation grace window (seconds).
# Grace covers racing /refresh calls from the same client; reuse outside the
# grace window is treated as theft and revokes all sessions for the user.
REFRESH_TTL_DAYS=30
REFRESH_ROTATION_GRACE_SEC=60

# Platform admin seed (Phase 13.3c). In NODE_ENV=production the API REFUSES
# to boot if ADMIN_PASSWORD is left as the dev default (`password123`).
ADMIN_EMAIL=admin@np.dev
ADMIN_PASSWORD=password123

# OTP / SMS
SMS_PROVIDER=mock
SMS_API_KEY=

# ─── Payment (Phase 13.4 — adapter pattern) ────────────
# PAYMENT_PROVIDER:
#   auto  (default) → use omise when keys present, fall back to mock
#   omise           → force omise (boot warns + falls back to mock if keys missing)
#   mock            → force mock (dev/CI only)
PAYMENT_PROVIDER=auto

# Omise (Opn). Test keys → skey_test_… / pkey_test_… ; live → skey_live_… / pkey_live_…
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
# Set in Omise dashboard when you create the webhook; we HMAC-verify every
# inbound POST /v1/payments/webhook/omise call against this secret.
OMISE_WEBHOOK_SECRET=
PROMPTPAY_ID=

# ─── Logistics ─────────────────────────────────────────
SHIPPOP_API_KEY=
FLASH_API_KEY=
KERRY_API_KEY=
GRAB_API_KEY=
LALAMOVE_API_KEY=

# ─── Maps ──────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Notification (Phase 9.1) ──────────────────────────
# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
WEB_PUSH_VAPID_SUBJECT=mailto:no-reply@np-commerce.com

# FCM — two options:
#   1) Modern: FCM_SERVICE_ACCOUNT_JSON (raw service-account JSON, single line)
#      or GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#   2) Legacy: FCM_SERVER_KEY (deprecated by Google but still works)
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=

# APNs (direct, no FCM) — only needed when NOT routing through Firebase
APNS_KEY_PATH=
APNS_KEY_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=app.np.commerce
APNS_PRODUCTION=false

# Email
EMAIL_FROM=no-reply@np-commerce.com
EMAIL_PROVIDER=resend           # resend | smtp
EMAIL_API_KEY=                  # Resend API key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Review reminder cron (Phase 9.1)
REVIEW_REMINDER=on              # on | off
REVIEW_REMINDER_INTERVAL_MS=3600000

# ─── LINE OA (Messaging API — notifications) ──────────
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_ACCESS_TOKEN=
LINE_LIFF_ID=

# ─── LINE Login (Phase 21 — customer auth) ────────────
# Separate channel from the Messaging API above. Create one at
# https://developers.line.biz/console → "Create new channel" →
# "LINE Login". The LIFF app (NEXT_PUBLIC_LINE_LIFF_ID below) must
# be created under THIS channel — not the Messaging one.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Public LIFF ID — exposed to the browser bundle.
NEXT_PUBLIC_LINE_LIFF_ID=

# ─── Observability (Phase 13.1) ───────────────────────
# Sentry — leave blank to disable (init logs "SENTRY_DSN not set" and skips).
# Set on both API and Web; web also accepts NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional environment tag (default = NODE_ENV) and release SHA. CI envs like
# RAILWAY_GIT_COMMIT_SHA / VERCEL_GIT_COMMIT_SHA are auto-detected too.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Performance sampling — leave 0 unless actively investigating latency.
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Make bootstrap migrations exit the process on failure (default: true in prod,
# false in dev). Recommended `true` everywhere once you have a process manager
# that will restart the API — silent migration failures cause invisible bugs.
STRICT_MIGRATIONS=

POSTHOG_KEY=

# ─── AI ────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── CS Chatbot (Phase 9.3) ────────────────────────────
# When CHATBOT_ENABLED=false the widget hides entirely and the API still
# accepts messages (useful for staging tests).
CHATBOT_ENABLED=true
CHATBOT_GREETING=สวัสดีค่ะ ฉันคือพี่ปัน ผู้ช่วยลูกค้า — มีอะไรให้ช่วยไหมคะ?
# Explicit provider pick: "openai" | "anthropic" | "none".
# If unset, auto-resolves to whichever API key is present.
LLM_PROVIDER=
# Model overrides (defaults shown):
OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ─── Behavioural Firehose (Phase 10.1) ─────────────────
# How long to keep raw user_events before auto-purge (per global floor).
# Users can override (tighter) on /profile/privacy. Min 30 days enforced.
EVENT_RETENTION_DAYS=180
# Set to "true" to disable the retention cron (useful in dev or read-replica)
EVENT_RETENTION_DISABLED=false

# ─── Taste Profile + Ranker (Phase 10.2) ───────────────
# How many days of behaviour go into each user's taste profile.
TASTE_WINDOW_DAYS=30
# Exponential-decay half-life — older events contribute less.
TASTE_HALF_LIFE_DAYS=14
# How often the background worker rebuilds dirty profiles.
TASTE_TICK_MS=30000
# Minimum weighted events before a user is no longer cold-start.
TASTE_COLD_START_MIN=3
# Disable the periodic worker (rebuilds will only happen on demand).
TASTE_WORKER_DISABLED=false

# Optional: LLM rerank the top-30 candidates → top-10 before display.
# Adds ~200-800ms latency and uses OPENAI_API_KEY / ANTHROPIC_API_KEY.
# Falls back silently to the deterministic ranker on any error/timeout.
LLM_RERANK_ENABLED=false
# OPENAI_RERANK_MODEL=gpt-4o-mini
# ANTHROPIC_RERANK_MODEL=claude-3-5-haiku-latest

# ─── Proactive Surfaces (Phase 10.3) ──────────────────
# Global kill switch for ALL proactive sweepers (browse-abandon, win-back, etc.)
PROACTIVE_SWEEPS_DISABLED=false
# Per-sweep kill switches (set any to "true" to disable just that sweep)
# PROACTIVE_BROWSE_ABANDON_DISABLED=false
# PROACTIVE_CART_ABANDON_DISABLED=false
# PROACTIVE_WIN_BACK_DISABLED=false
# PROACTIVE_FAV_SHOP_NEW_ARRIVAL_DISABLED=false
# PROACTIVE_PRICE_DROP_DISABLED=false
# PROACTIVE_PRICE_SNAPSHOT_DISABLED=false
